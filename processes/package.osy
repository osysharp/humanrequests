// Osysharp.HumanRequests.Processes — what a process asks of people, told on the process's own run.
//
// A process is a workflow, and asking a person from one is an ordinary call — nothing here is written at the call:
//
//     state Interviewing {
//       enter {
//         var ask = Workflow.Once("ask-feedback", () => PutRequest(feedbackForm));
//         var answer = await Requests.Answer(ask);                 // the run waits here, however long it takes
//         …
//       }
//     }
//
// With both kits in an app this bridge is there, and:
//
// ⚑ THE RUN TELLS WHOM IT ASKED, AND WHO ANSWERED. A request put from a workflow's run is a line of that run, in the
//   state that put it — asked of whom; that its date passed and whom it went on to; who answered, and after how
//   long; that nobody did — so a state that waits for a person no longer reads "Nothing was recorded here."
//
// ⚑ THE LINE OPENS THE REQUEST, as whoever is looking may read it: the question, the answer, and when.
package Osysharp.HumanRequests.Processes {
  version     "1.2.0";
  minPlatform "0.17.0";
  summary     "people inside business processes: each request a workflow's run puts to a person — a question, an approval, a form, a link sent to somebody outside — is told on that run in the state that put it: who was asked, that its date passed and whom it went on to, who answered and after how long, or that nobody did; and each line opens the request in place.";
  completes   Osysharp.HumanRequests@1, Osysharp.Processes@1;

  model "model/**/*.osy";
  tests "tests";
  use Osysharp.HumanRequests@1;
  use Osysharp.Processes@1;
  use Osysharp.WorkQueues@1;
  use Osysharp.Llm@2;
  use Osysharp.Identity@0;
  use Osysharp.Workflow;
  use Osysharp.ServiceHours;
  use Osysharp.Diagrams@0;
  use Osysharp.Ui;
}
