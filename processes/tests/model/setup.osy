// The firm's agents, its one scripted model, its process and how it keeps what a hire learns. In a file of its own
// with no `namespace`, because an `app.X = …` statement's value is resolved outside the file's namespace.
using Osysharp.Agents;
using Osysharp.Agents.HumanRequests;
using Osysharp.Agents.Inspector;
using Osysharp.Processes;
using Osysharp.WorkRepositories;
using Osysharp.WorkRepositories.Agents;
using Osysharp.Llm;
using Osysharp.WorkQueues;
using Osysharp.Privacy;
using Staffing;

app.Llm = new LlmSetup {
  Models = [
    new LlmModel { Name = "Small", Client = new ScriptedModel { Name = "Small" }, Model = "scripted-small",
                   Price = new LlmPrice { Input = 1, Output = 5 }, MaxOutputTokens = 1000 },
  ],
  Default = "Small",
};

app.Agents = new AgentsSetup {
  Agents = [new HiringCoordinator(), new ApplicationReader()],
  TaskBudget = 0.05m,
};
app.Processes = new ProcessesSetup { Processes = [new HiringProcess()], RunPage = "/hires/{run}" };
app.AgentInspector = new AgentInspectorSetup { WorkPage = "/work/{task}/{step}" };
// What anybody thought of a candidate is read by few, and kept half a year after the hire closes; an application is
// kept as long.
app.WorkRepositories = new WorkRepositoriesSetup {
  Kinds = [
    new KindRule { Kind = ItemKind.Finding, Restricted = true, RetainFor = TimeSpan.FromDays(183) },
    new KindRule { Kind = ItemKind.Document, RetainFor = TimeSpan.FromDays(183) },
  ],
  ItemPath = "/items/",
};
// What an agent hands back is not filed as a finding by itself here: every finding of a hire is about one candidate,
// and is written — and marked as theirs — by the action that records it.
app.AgentFindings = new AgentFindingsSetup { FileResults = false };
app.AgentRequests = new AgentRequestsSetup { Queue = "Hiring" };
app.Inbox = new InboxSetup { DefaultQueue = "Hiring" };
app.Privacy = new PrivacySetup { Controller = "Tallis & Wren AB", SupervisoryAuthority = "IMY, imy.se" };
