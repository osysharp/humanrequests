// The yard's screens — the inbox as the WorkQueues kit draws it, where a request shows as the HumanRequests kit draws
// it; a quote's page with who it is waiting on; and the page a boat's owner answers on, behind their link.
namespace Boatyard;

using Osysharp.Identity;
using Osysharp.WorkQueues;
using Osysharp.HumanRequests;

[Layout]
component YardFrame() {
  live var me = Session.CurrentUser;
  live var myName = me == null ? "" : me.DisplayName;
  action SignOut() { Session.SignOut(); }
  action Appearance() { Theme.Toggle(); }
  render {
    InboxShell(new AppChrome {
      Product = "Kestrel yard",
      Tagline = "Inbox",
      Mark = Icons.Inbox,
      Home = "/inbox/mine",
      Panes = true,
      User = new ShellUser {
        Name = myName, Initials = InitialsOf(myName == "" ? "?" : myName), Presence = ShellPresence.Online,
        Menu = [
          new MenuAction { Label = "Appearance", Icon = Icons.Eye, OnPress = Appearance },
          new MenuAction { Label = "Sign out", Icon = Icons.Logout, OnPress = SignOut, Tone = Tone.Danger, Divided = true },
        ],
      },
      Nav = [],
    }) {
      Outlet(retain: 4);
    }
  }
}

[Route("/")] [Layout(YardFrame)] [Authorize(WorksInbox)] [Render(CSR)] [Title("Inbox")]
component Home() {
  render { InboxPanes("mine", r => "/inbox/mine/i/" + r.Id, Guid.Empty) { InboxOverview("mine"); } }
}

[Route("/inbox/{view}")] [Layout(YardFrame)] [Authorize(WorksInbox)] [Render(CSR)] [Title("Inbox")]
component InboxPage(string view) {
  render { InboxPanes(view, r => "/inbox/" + view + "/i/" + r.Id, Guid.Empty) { InboxOverview(view); } }
}

/// One item beside the list — its head as the inbox draws it and, under it, what it IS as its own kit draws it.
[Route("/inbox/{view}/i/{id}")] [Layout(YardFrame)] [Authorize(WorksInbox)] [Render(CSR)] [Title("Item")]
component ItemPage(string view, Guid id) {
  live var items = WorkItem.Where(w => w.Id == id).Include(w => w.Queue).Include(w => w.Assignee).ToList();
  render {
    InboxPanes(view, r => "/inbox/" + view + "/i/" + r.Id, id) {
      Stack(gap: 0, grow: 1, minW: "0", h: "100%", minH: "0", overflowY: Overflow.Auto) {
        if (!Layout.AtLeast(Tablet)) {
          Row(px: 4, pt: 3) { Link(href: "/inbox/" + view, label: "Back to the list") { Icon(Icons.ChevronLeft); } }
        }
        foreach (var item in items) { WorkItemView(item); }
      }
    }
  }
}

/// A quote, with who its process is waiting on.
[Route("/quotes/{id}")] [Layout(YardFrame)] [Authorize(WorksInbox)] [Render(CSR)] [Title("Quote")]
component QuotePage(Guid id) {
  live var quotes = Quote.Where(q => q.Id == id).Include(q => q.Boat).ToList();
  render {
    Stack(gap: 5, p: 5, maxW: "720px") {
      foreach (var q in quotes) {
        PageHead(q.Work, subtitle: q.Boat.Name + " · " + q.Amount.ToString("0.00") + " EUR · revision " + q.Revision);
        WaitingOnPeople(waitingType: "Quote", waitingId: q.Id, open: r => "/inbox/open/i/" + r);
      }
    }
  }
}

/// What the yard draws for a request that is about a quote: its lines, as they were shown.
[Contribution("Quote")]
component QuoteOnARequest(string subjectType, Guid subjectId, Guid request, Action changed) : RequestSubject {
  live var quotes = Quote.Where(q => q.Id == subjectId).Include(q => q.Boat).ToList();
  render {
    foreach (var q in quotes.Where(x => subjectType == "Quote")) {
      Stack(gap: 1, px: 4, py: 3, borderW: 1, border: Colors.Border, rounded: Radius.Lg, label: "Quote") {
        Text(q.Work, fontSize: FontSize.Body, fontWeight: FontWeight.Medium);
        Text(q.Boat.Name + ", revision " + q.Revision, fontSize: FontSize.Label, color: Colors.TextMuted);
      }
    }
  }
}

/// Where a boat's owner answers: the page behind the link in the mail the yard sent.
[Route("/answer/{link}")] [AllowAnonymous] [Render(CSR)] [Title("A question from Kestrel yard")]
component AnswerPage(AnswerLink link) {
  render { ExternalAnswer(link); }
}
